#include <stdlib.h>

#define HASH_SIZE 20011

typedef struct {
    int key;
    int value;
    int occupied;
} HashEntry;


int hash(int key) {
    int h = key % HASH_SIZE;
    if (h < 0) {
        h += HASH_SIZE;
    }
    return h;
}

void insert(HashEntry* table, int key, int value) {
    int index = hash(key);
    while (table[index].occupied) {
        index = (index + 1) % HASH_SIZE;
    }
    table[index].key = key;
    table[index].value = value;
    table[index].occupied = 1;
}

int search(HashEntry* table, int key) {
    int index = hash(key);
    while (table[index].occupied) {
        if (table[index].key == key) {
            return table[index].value;
        }
        index = (index + 1) % HASH_SIZE;
    }
    return -1;
}

int* twoSum(int* nums, int numsSize, int target, int* returnSize) {
    int* result = (int*)malloc(2 * sizeof(int));
    *returnSize = 2;

   
    HashEntry* table = (HashEntry*)calloc(HASH_SIZE, sizeof(HashEntry));
    if (!table) {
        return NULL;
    }

    for (int i = 0; i < numsSize; i++) {
        int complement = target - nums[i];
        int complementIndex = search(table, complement);
        
        if (complementIndex != -1) {
            result[0] = complementIndex;
            result[1] = i;
            free(table);
            return result;
        }
        
        insert(table, nums[i], i);
    }

    free(table);
    return NULL;
}
