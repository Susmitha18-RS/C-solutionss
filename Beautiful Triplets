#include <stdio.h>
#include <stdlib.h>

int beautifulTriplets(int d, int arr_count, int* arr) {
 
    int freq[20005] = {0};
    int count = 0;
    

    for (int i = 0; i < arr_count; i++) {
        freq[arr[i]]++;
    }
    

    for (int i = 0; i < arr_count; i++) {
        int val = arr[i];
        
     
        if (val + 2 * d <= 20000) {
            if (freq[val + d] > 0 && freq[val + 2 * d] > 0) {
       
                count += freq[val + d] * freq[val + 2 * d];
                
     
                freq[val] = 0;
            }
        }
    }
    
    return count;
}

int main() {
    int n, d;
    if (scanf("%d %d", &n, &d) != 2) return 1;
    
    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) return 1;
    }
    
    int result = beautifulTriplets(d, n, arr);
    printf("%d\n", result);
    
    free(arr);
    return 0;
}
