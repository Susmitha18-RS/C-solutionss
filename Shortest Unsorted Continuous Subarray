#include <stdio.h>

int findUnsortedSubarray(int* nums, int numsSize) {
    if (numsSize <= 1) return 0;

    int end = -1;
    int maxVal = nums[0];
    

    for (int i = 1; i < numsSize; i++) {
        if (nums[i] < maxVal) {
            end = i;
        } else {
            maxVal = nums[i];
        }
    }
    

    if (end == -1) return 0;
    
    int start = 0;
    int minVal = nums[numsSize - 1];
    
   
    for (int i = numsSize - 2; i >= 0; i--) {
        if (nums[i] > minVal) {
            start = i;
        } else {
            minVal = nums[i];
        }
    }
    
   
}
