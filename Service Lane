#include <stdio.h>
#include <stdlib.h>


int* serviceLane(int n, int width_count, int* width, int cases_rows, int cases_cols, int** cases, int* result_count) {
   
    *result_count = cases_rows;
    int* result = (int*)malloc(cases_rows * sizeof(int));
    
  
    for (int c = 0; c < cases_rows; c++) {
        int start = cases[c][0];
        int end = cases[c][1];
       
        int min_width = 4; 
        
        for (int i = start; i <= end; i++) {
            if (width[i] < min_width) {
                min_width = width[i];
            }
            if (min_width == 1) {
                break;
            }
        }
        
        result[c] = min_width;
    }
    
    return result;
}

int main() {
    int n, t;
    if (scanf("%d %d", &n, &t) != 2) return 1;
    

    int* width = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &width[i]) != 1) return 1;
    }
    
   
    int** cases = (int**)malloc(t * sizeof(int*));
    for (int i = 0; i < t; i++) {
        cases[i] = (int*)malloc(2 * sizeof(int));
        if (scanf("%d %d", &cases[i][0], &cases[i][1]) != 2) return 1;
    }
    
    int result_count;
    int* result = serviceLane(n, n, width, t, 2, cases, &result_count);

    for (int i = 0; i < result_count; i++) {
        printf("%d\n", result[i]);
    }
    

    free(result);
    for (int i = 0; i < t; i++) {
        free(cases[i]);
    }
    free(cases);
    free(width);
    
    return 0;
}
