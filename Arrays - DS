#include <stdio.h>
#include <stdlib.h>

void reverseArray(int* arr, int size) {
    int start = 0;
    int end = size - 1;
    
    while (start < end) {
      
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        

        start++;
        end--;
    }
}

int main() {
    int n;
    

    if (scanf("%d", &n) != 1) return 1;
    
  
    int* arr = (int*)malloc(n * sizeof(int));
    if (arr == NULL) return 1;
    
 
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) return 1;
    }
    

    reverseArray(arr, n);
   
    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");
    

    free(arr);
    
    return 0;
}
