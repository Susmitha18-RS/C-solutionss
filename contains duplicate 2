#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <math.h>



typedef struct Node {
    int val;
    struct Node* next;
} Node;

typedef struct {
    Node* buckets[HASH_SIZE];
} HashTable;

unsigned int hash_function(int key) {
    unsigned int x = (unsigned int)key;
    x ^= x >> 16;
    x *= 0x7feb352d;
    x ^= x >> 15;
    x *= 0x846ca68b;
    x ^= x >> 16;
    return x % HASH_SIZE;
}


void insert(HashTable* table, int key) {
    unsigned int idx = hash_function(key);
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode->val = key;
    newNode->next = table->buckets[idx];
    table->buckets[idx] = newNode;
}


bool find(HashTable* table, int key) {
    unsigned int idx = hash_function(key);
    Node* curr = table->buckets[idx];
    while (curr != NULL) {
        if (curr->val == key) return true;
        curr = curr->next;
    }
    return false;
}


void delete(HashTable* table, int key) {
    unsigned int idx = hash_function(key);
    Node* curr = table->buckets[idx];
    Node* prev = NULL;
    
    while (curr != NULL) {
        if (curr->val == key) {
            if (prev == NULL) {
                table->buckets[idx] = curr->next;
            } else {
                prev->next = curr->next;
            }
            free(curr);
            return;
        }
        prev = curr;
        curr = curr->next;
    }
}


void freeTable(HashTable* table) {
    for (int i = 0; i < HASH_SIZE; i++) {
        Node* curr = table->buckets[i];
        while (curr != NULL) {
            Node* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
}

bool containsNearbyDuplicate(int* nums, int numsSize, int k) {
    if (numsSize <= 1 || k <= 0) return false;


    HashTable* table = (HashTable*)calloc(1, sizeof(HashTable));
    
    for (int i = 0; i < numsSize; i++) {
        
        if (find(table, nums[i])) {
            freeTable(table);
            free(table);
            return true;
        }
        
       
        insert(table, nums[i]);
        
  
        if (i >= k) {
            delete(table, nums[i - k]);
        }
    }
    
    freeTable(table);
    free(table);
    return false;
}
