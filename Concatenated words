#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>


typedef struct HashNode {
    char *word;
    struct HashNode *next;
} HashNode;



unsigned int hash(const char *str) {
    unsigned int h = 0;
    while (*str) h = h * 31 + *str++;
    return h % HASH_SIZE;
}

void insert(HashNode **table, const char *word) {
    unsigned int h = hash(word);
    HashNode *node = malloc(sizeof(HashNode));
    node->word = strdup(word);
    node->next = table[h];
    table[h] = node;
}

bool search(HashNode **table, const char *word) {
    unsigned int h = hash(word);
    HashNode *curr = table[h];
    while (curr) {
        if (strcmp(curr->word, word) == 0) return true;
        curr = curr->next;
    }
    return false;
}


bool canForm(const char *word, int len, HashNode **table, int count) {
    if (len == 0) return count >= 2;
    
    char prefix[35];
    for (int i = 1; i <= len; i++) {
        strncpy(prefix, word, i);
        prefix[i] = '\0';
        
        if (search(table, prefix)) {
            if (canForm(word + i, len - i, table, count + 1)) {
                return true;
            }
        }
    }
    return false;
}


char** findAllConcatenatedWordsInADict(char** words, int wordsSize, int* returnSize) {
    HashNode *table[HASH_SIZE] = {NULL};
    for (int i = 0; i < wordsSize; i++) {
        insert(table, words[i]);
    }
    
    char **result = malloc(sizeof(char*) * wordsSize);
    *returnSize = 0;
    
    for (int i = 0; i < wordsSize; i++) {
        int len = strlen(words[i]);
        if (len == 0) continue;
        
        if (canForm(words[i], len, table, 0)) {
            result[*returnSize] = strdup(words[i]);
            (*returnSize)++;
        }
    }
    
   
    return result;
}
