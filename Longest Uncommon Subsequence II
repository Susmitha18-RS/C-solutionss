#include <stdio.h>
#include <string.h>
#include <stdbool.h>


bool isSubsequence(const char* s1, const char* s2) {
    int i = 0, j = 0;
    int len1 = strlen(s1);
    int len2 = strlen(s2);
    
    while (i < len1 && j < len2) {
        if (s1[i] == s2[j]) {
            i++;
        }
        j++;
    }
    return i == len1;
}

int findLUSlength(char** strs, int strsSize) {
    int maxLen = -1;
    
  
    for (int i = 0; i < strsSize; i++) {
        bool isUncommon = true;
        
        for (int j = 0; j < strsSize; j++) {
            if (i == j) continue;
            
            if (isSubsequence(strs[i], strs[j])) {
                isUncommon = false;
                break; 
            }
        }
        
       
        if (isUncommon) {
            int len = strlen(strs[i]);
            if (len > maxLen) {
                maxLen = len;
            }
        }
    }
    
    return maxLen;
}
