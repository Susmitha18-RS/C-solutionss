#include <stdio.h>
#include <stdlib.h>
#include <math.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))


int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return abs(a);
}


typedef struct {
    int dx;
    int dy;
    int count;
} SlopeNode;

int maxPoints(int** points, int pointsSize, int* pointsColSize) {
    if (pointsSize <= 2) return pointsSize;
    
    int maxOverall = 1;
    
    
    for (int i = 0; i < pointsSize; i++) {
      
        SlopeNode* slopes = (SlopeNode*)malloc(pointsSize * sizeof(SlopeNode));
        int slopesCount = 0;
        int localMax = 0;
        
        for (int j = i + 1; j < pointsSize; j++) {
            int dx = points[j][0] - points[i][0];
            int dy = points[j][1] - points[i][1];
            
            
            int g = gcd(dx, dy);
            dx /= g;
            dy /= g;
            
            
            if (dx < 0) {
                dx = -dx;
                dy = -dy;
            } else if (dx == 0) {
                dy = abs(dy); 
            }
            
    
            int found = 0;
            for (int k = 0; k < slopesCount; k++) {
                if (slopes[k].dx == dx && slopes[k].dy == dy) {
                    slopes[k].count++;
                    localMax = MAX(localMax, slopes[k].count);
                    found = 1;
                    break;
                }
            }
            
    
            if (!found) {
                slopes[slopesCount].dx = dx;
                slopes[slopesCount].dy = dy;
                slopes[slopesCount].count = 1;
                localMax = MAX(localMax, 1);
                slopesCount++;
            }
        }
        
        maxOverall = MAX(maxOverall, localMax + 1);
        free(slopes);
    }
    
    return maxOverall;
}
