#include <stdio.h>
#include <stdlib.h>


long arrayManipulation(int n, int queries_rows, int queries_columns, int** queries) {
 
    long* diff = (long*)calloc(n + 2, sizeof(long));
    if (diff == NULL) return 0;

    for (int i = 0; i < queries_rows; i++) {
        int a = queries[i][0];
        int b = queries[i][1];
        long k = queries[i][2];

        diff[a] += k;
        diff[b + 1] -= k;
    }

    long max_val = 0;
    long current_sum = 0;
    for (int i = 1; i <= n; i++) {
        current_sum += diff[i];
        if (current_sum > max_val) {
            max_val = current_sum;
        }
    }

    free(diff);

    return max_val;
}

int main() {
    int n, m;
    if (scanf("%d %d", &n, &m) != 2) return 1;

    int** queries = (int**)malloc(m * sizeof(int*));
    for (int i = 0; i < m; i++) {
        queries[i] = (int*)malloc(3 * sizeof(int));
        if (scanf("%d %d %d", &queries[i][0], &queries[i][1], &queries[i][2]) != 3) {
            return 1;
        }
    }

    long result = arrayManipulation(n, m, 3, queries);

    printf("%ld\n", result);

    for (int i = 0; i < m; i++) {
        free(queries[i]);
    }
    free(queries);

    return 0;
}
