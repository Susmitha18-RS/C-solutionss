#include <stdio.h>
#include <stdlib.h>

int* rotateLeft(int d, int arr_count, int* arr, int* result_count) {
    *result_count = arr_count;
    int* rotated = (int*)malloc(arr_count * sizeof(int));
    
    d = d % arr_count;
    
    for (int i = 0; i < arr_count; i++) {

        int new_index = (i + arr_count - d) % arr_count;
        rotated[new_index] = arr[i];
    }
    
    return rotated;
}

int main() {
    int n, d;
    if (scanf("%d %d", &n, &d) != 2) return 1;
    
    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) return 1;
    }
    
    int result_count;
    int* result = rotateLeft(d, n, arr, &result_count);
    
    for (int i = 0; i < result_count; i++) {
        printf("%d", result[i]);
        if (i < result_count - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
    free(arr);
    free(result);
    return 0;
}
