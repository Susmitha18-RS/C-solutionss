#include <stdio.h>
#include <stdlib.h>
#include <math.h>


int compare(const void *a, const void *b) {
    int val1 = *(const int *)a;
    int val2 = *(const int *)b;
    if (val1 < val2) return -1;
    if (val1 > val2) return 1;
    return 0;
}

int findRadius(int* houses, int housesSize, int* heaters, int heatersSize) {
    
    qsort(heaters, heatersSize, sizeof(int), compare);
    
    int maxRadius = 0;
    
  
    for (int i = 0; i < housesSize; i++) {
        int housePos = houses[i];
        

        int low = 0;
        int high = heatersSize - 1;
        
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (heaters[mid] < housePos) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }
        
        
        int dist1 = (low < heatersSize) ? (heaters[low] - housePos) : __INT_MAX__;
        int dist2 = (high >= 0) ? (housePos - heaters[high]) : __INT_MAX__;
        
        
        int currentMinDistance = (dist1 < dist2) ? dist1 : dist2;
        
        
        if (currentMinDistance > maxRadius) {
            maxRadius = currentMinDistance;
        }
    }
    
    return maxRadius;
}
