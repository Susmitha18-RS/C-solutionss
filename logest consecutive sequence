#include <stdlib.h>
#include <stdbool.h>


#define HASH_SIZE 200003

typedef struct {
    int key;
    bool occupied;
} HashEntry;


int hashFunction(int key) {
    int h = key % HASH_SIZE;
    if (h < 0) h += HASH_SIZE;
    return h;
}


void insert(HashEntry* table, int key) {
    int idx = hashFunction(key);
    while (table[idx].occupied) {
        if (table[idx].key == key) return; // Already present, avoid duplicates
        idx = (idx + 1) % HASH_SIZE;
    }
    table[idx].key = key;
    table[idx].occupied = true;
}


bool search(HashEntry* table, int key) {
    int idx = hashFunction(key);
    while (table[idx].occupied) {
        if (table[idx].key == key) return true;
        idx = (idx + 1) % HASH_SIZE;
    }
    return false;
}

int longestConsecutive(int* nums, int numsSize) {
    if (numsSize == 0) return 0;


    HashEntry* table = (HashEntry*)calloc(HASH_SIZE, sizeof(HashEntry));
    if (!table) return 0;


    for (int i = 0; i < numsSize; i++) {
        insert(table, nums[i]);
    }

    int longestStreak = 0;


    for (int i = 0; i < numsSize; i++) {
        int currentNum = nums[i];

      
        if (!search(table, currentNum - 1)) {
            int currentNumStreak = currentNum;
            int currentStreak = 1;


            while (search(table, currentNumStreak + 1)) {
                currentNumStreak++;
                currentStreak++;
            }


            if (currentStreak > longestStreak) {
                longestStreak = currentStreak;
            }
        }
    }

    free(table);
    return longestStreak;
}
